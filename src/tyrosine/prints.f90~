module prints
  !
  ! some routines for printing things, i.e. info, warnings, logo, etc
  !
  use options, only:c_double
  implicit none
contains

  !
  ! A subroutine to print the main Mescaline logo at the beginning of the run
  !
  subroutine print_mescaline()
    print "(a)",'                                         |_)                 '
    print "(a)",'          __ `__ \   _ \  __|  __|  _` | | | __ \   _ \      '
    print "(a)",'          |   |   |  __/\__ \ (    (   | | | |   |  __/      '
    print "(a)",'         _|  _|  _|\___|____/\___|\__,_|_|_|_|  _|\___|      '
    print "(a)",''
    print "(a)",'   Extracting interesting things from your Cactus (HDF5 files) '
    print "(a)", '                  See you on the other side.               '
    print "(a)", ''
  end subroutine print_mescaline


  !
  ! A subroutine to print an error message with a particular severity.
  !
  !      severity = 0 --> not that bad, just prints error and moves on
  !      severity = 1 --> pretty bad, you should probably exit, but the code won't crash
  !      severity = 2 --> real bad, the code will (or already has) crash
  !
  subroutine print_error(message,severity,loc)
    integer, intent(in) :: severity
    character(len=*), intent(in) :: message,loc

    if (severity==0) then
       print "(a)", ""
       print "(a)"," --> BAD TRIP ("//trim(loc)//"): "//trim(message)
       print "(a)", ""
       print "(a)", "     Just some gentle nausea. Carrying on. "
       !read*
    elseif (severity==1) then
       print "(a)", ""
       print "(a)"," --> BAD TRIP ("//trim(loc)//"): "//trim(message)
       print "(a)", ""
       print "(a)", "     Maybe re-think your choices. " !Press <enter> to continue. "
       !read*
    elseif (severity==2) then
       print "(a)", ""
       print "(a)"," --> BAD TRIP ("//trim(loc)//"): "//trim(message)
       print "(a)", ""
       print "(a)", "     You've had enough. "
       stop
    endif

  end subroutine print_error


  !
  ! A subroutine to print some general info - to make sure it prints in the same format
  !
  subroutine print_info(message,loc)
    character(len=*), intent(in) :: message
    character(len=*), intent(in), optional :: loc ! where the message is coming from, and advance?

    if (present(loc)) then
       write(*,"(a)") trim(loc)//": "//trim(message)
    else
       write(*,"(a)") trim(message)
    endif

  end subroutine print_info



  !
  ! A subroutine to provide a nice complement at the end of a run
  !
  subroutine print_compliment()
      use random, only:get_randnums
      use options, only:clen
      integer, parameter :: n=23 ! number of compliments
      real(c_double) :: randnums(1)
      integer :: rn
      character(len=clen) :: comps(n),loc
      loc = " print_compliment"

      comps(1) = "You did great"
      comps(2) = "I hope you have a great day!"
      comps(3) = "You're awesome!"
      comps(4) = "Nice work today"
      comps(5) = "You have a really nice way of doing things"
      comps(6) = "You have a great attitude"
      comps(7) = "Yay!"
      comps(8) = "Everything will be ok!"
      comps(9) = "Fabulous job doing that thing you do!"
      comps(10) = "You're the best"
      comps(11) = "You did it!"
      comps(12) = "Keep on keeping on"
      comps(13) = "You're doing better than you think!"
      comps(14) = "Great work!!"
      comps(15) = "You're a value to society"
      comps(16) = "Woohoo!!"
      comps(17) = "You make a damn good tahini sauce"
      comps(18) = "Nice haircut!"
      comps(19) = "Wow you have a great head"
      comps(20) = "It's ok to cry"
      comps(21) = "Cool 'tude"
      comps(22) = "You diiiiid it"
      comps(23) = "You are great at cooking"

      ! call to get ONE random number in range (0,1)
      call get_randnums(1,randnums)
      ! scale this to be an integer between (1,n)
      rn = int(randnums(1)*(n+1))
      if (rn==0) rn = rn + 1
      if (rn>n .or. rn<1) then
          print*, rn
          call print_error("You're not so great now, are you?",2,loc)
      endif
      print*, comps(rn)

  end subroutine print_compliment










end module prints
